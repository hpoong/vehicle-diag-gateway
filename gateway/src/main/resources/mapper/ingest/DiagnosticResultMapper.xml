<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hopoong.diag.gateway.ingest.DiagnosticResultMapper">
    <resultMap id="existingResult" type="com.hopoong.diag.gateway.ingest.ExistingResult">
        <constructor>
            <idArg column="id" javaType="_long"/>
            <arg column="payload_hash" javaType="java.lang.String"/>
            <arg column="policy_code" javaType="java.lang.String"/>
            <arg column="received_at" javaType="java.time.OffsetDateTime"/>
            <arg column="delivery_event_id" javaType="java.lang.String"/>
            <arg column="delivery_status" javaType="java.lang.String"/>
        </constructor>
    </resultMap>
    <select id="findByKey" resultMap="existingResult">
        SELECT r.id, r.payload_hash, r.policy_code, r.received_at,
               o.event_id::text AS delivery_event_id, o.status AS delivery_status
          FROM diagnostic_result r
          LEFT JOIN outbox_event o ON o.result_id = r.id
         WHERE r.device_id = #{deviceId} AND r.event_id = #{eventId}
    </select>
</mapper>
